{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskMaster",
  "version": "1.3.1",
  "identifier": "com.diskmaster.app",
  "mainBinaryName": "DiskMaster",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Диск-Мастер",
        "width": 1100,
        "height": 700,
        "minWidth": 880,
        "minHeight": 540,
        "visible": false,
        "backgroundColor": "#070b12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Development SPB",
    "copyright": "© 2026 Development SPB",
    "shortDescription": "Очистка диска, анализ места и мониторинг Windows",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1NkUwNjNBMEIwREM5MzgKUldRNHlRMExPZ1p1QlpvdVN2VUlEU0NVR1dnOXRhM0dCR3BOZzlxd2dDYTc5U09FaE9jVnRkYk8K",
      "endpoints": [
        "https://github.com/xxxronelxxx/diskmaster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
